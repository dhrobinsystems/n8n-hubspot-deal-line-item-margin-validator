# n8n-hubspot-deal-line-item-margin-validator
# Copy to .env (Node.js mirror) or set as n8n environment variables.
# Every value below is a placeholder or a safe default. Blank values and
# "your_..._here" placeholders are treated as unset.

# --- Safety gates (fail-safe defaults) ---------------------------------------
# DRY_RUN=true evaluates every deal and writes nothing.
DRY_RUN=true
# SANDBOX_MODE=true only talks to a verified SANDBOX or DEVELOPER_TEST portal.
SANDBOX_MODE=true
# Required (together with SANDBOX_MODE=false) before production deals are written.
ALLOW_PRODUCTION_MODE=false
# Optional: pin the sandbox portal ID so a token for another portal is refused.
HUBSPOT_SANDBOX_PORTAL_ID=your_hubspot_sandbox_portal_id_here

# --- HubSpot -----------------------------------------------------------------
# Node.js mirror only. In n8n, store the token in a "HubSpot App Token" credential.
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_BASE_URL=https://api.hubapi.com
# Comma-separated deal stage IDs that trigger validation.
PROPOSAL_STAGE_IDS=decisionmakerboughtin,contractsent
# Optional comma-separated pipeline IDs. Blank = every pipeline.
PIPELINE_IDS=

# --- Webhook authentication ----------------------------------------------------
REQUIRE_SIGNATURE=true
# hubspot_v3 (HubSpot app webhooks) or hmac_sha256 (your own relay).
SIGNATURE_MODE=hubspot_v3
SIGNATURE_TOLERANCE_SECONDS=300
# HubSpot app client secret (hubspot_v3) or shared relay secret (hmac_sha256).
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
# The exact public URL HubSpot calls; part of the v3 signature.
WEBHOOK_PUBLIC_URL=your_webhook_public_url_here

# --- Margin rules --------------------------------------------------------------
# Node.js mirror: path to your rules file. n8n: paste the JSON into MARGIN_RULES_JSON.
# Without either, only DRY_RUN=true runs (using the example rules).
MARGIN_RULES_FILE=
MARGIN_RULES_JSON=

# --- Approvals & notifications -------------------------------------------------
CREATE_APPROVAL_TASK=true
# violations | escalations | none
NOTIFY_ON=violations
# Re-write deals even when line items and rules are unchanged since the last check.
RECHECK_UNCHANGED=false
NOTIFICATION_WEBHOOK_URL=your_notification_webhook_url_here
SANDBOX_NOTIFICATION_WEBHOOK_URL=your_sandbox_notification_webhook_url_here
AUDIT_LOG_WEBHOOK_URL=your_audit_log_webhook_url_here

# --- Node.js mirror server -----------------------------------------------------
HOST=127.0.0.1
PORT=8792
